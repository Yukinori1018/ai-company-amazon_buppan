// Re-Sale AutoSync — Prisma スキーマ（FBA 有在庫モデル）
//
// 採用モデル: 即時仕入れ(ヤフオク落札)→ 検品 → ラベル貼替(外注) → FBA 納品 → 出品中
// 無在庫(FBM)前提の「ヤフオク在庫→Amazon在庫0/1 リアルタイム同期」は廃止。
// 実物を保有するため、1 SKU = 1 商品を「仕入れ〜FBA納品〜出品」のパイプラインで管理する。
//
// 既定は SQLite。PostgreSQL/MySQL へは provider と DATABASE_URL の差し替えで移行可能。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 仕入れた 1 商品（SKU 単位）。仕入れ〜FBA納品〜出品の状態を pipelineStage で追う。
model Product {
  id                  String    @id @default(cuid())
  asin                String
  sku                 String    @unique
  title               String?
  productType         String? // SP-API の productType（出品 PUT に必須）

  // --- 原価内訳（利益計算・監査用） ---
  purchasePrice       Int // 落札価格（円）
  procurementShipping Int       @default(0) // 仕入れ送料（円）
  prepCost            Int       @default(0) // 検品・ラベル貼替(外注)＋FBA入庫送料（円）
  fbaFee              Int       @default(0) // FBA 配送代行手数料（円/個）
  targetMargin        Float     @default(0.2) // 目標利益率
  sellPrice           Int // 自動計算した Amazon 販売価格（円）

  // --- 仕入れ元（一度きり。監視はしない） ---
  sourceUrl           String? // 仕入れ元 URL（ヤフオク等）
  sourceRef           String? // ヤフオクのオークションID 等
  purchasedAt         DateTime?

  // --- FBA パイプライン ---
  // SOURCED(仕入済) → INSPECTED(検品済) → RELABELED(ラベル貼替済) → INBOUND(FBA納品済)
  //   → LISTED(出品中) → SOLD_OUT(在庫切れ)
  pipelineStage       String    @default("SOURCED")
  listingState        String    @default("DRAFT") // DRAFT | LISTED | INACTIVE | ERROR
  fnsku               String? // FBA ラベル(FNSKU)。ラベル貼替の実体。

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  logs                PipelineLog[]

  @@index([pipelineStage])
  @@index([asin])
  @@index([listingState])
}

/// パイプラインの状態遷移ログ（いつ・どの段階へ・誰/何の操作で動いたか）。
model PipelineLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStage String?
  toStage   String
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

/// グローバル設定（既定利益率・手数料率・外注単価など）。UI から編集可能にする想定。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
