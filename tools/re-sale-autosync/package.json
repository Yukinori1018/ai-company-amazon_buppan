{
  "name": "re-sale-autosync",
  "version": "0.1.0",
  "private": true,
  "description": "ヤフオク!⇄Amazon 無在庫（FBM）出品ステータス自動同期ツール（雛形）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/jobs/monitorJob.ts",
    "auth:test": "tsx src/scripts/testAuth.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "p-limit": "^6.1.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "puppeteer": "^23.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.19.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
