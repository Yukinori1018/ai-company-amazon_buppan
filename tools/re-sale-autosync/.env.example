# ============================================================
# Re-Sale AutoSync 環境変数（.env.example → .env にコピーして実値を入れる）
# .env は .gitignore 済み。実値は絶対にコミットしない。
# ============================================================

# --- アプリ ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- データベース（SQLite 既定。PostgreSQL/MySQL に差し替え可） ---
DATABASE_URL="file:./dev.db"
# 例（PostgreSQL）: DATABASE_URL="postgresql://user:pass@localhost:5432/resale_autosync?schema=public"

# --- Amazon SP-API（LWA: Login with Amazon） ---
# セラーセントラル > アプリと連携 > 開発者コンソールで取得
SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SPAPI_LWA_CLIENT_SECRET=xxxxxxxx
SPAPI_LWA_REFRESH_TOKEN=Atzr|xxxxxxxx
# 出品先マーケットプレイス（日本）
SPAPI_MARKETPLACE_ID=A1VC38T7YXB528
SPAPI_SELLER_ID=Axxxxxxxxxxxxx
# エンドポイント（極東リージョン）
SPAPI_ENDPOINT=https://sellingpartnerapi-fe.amazon.com
SPAPI_LWA_ENDPOINT=https://api.amazon.com/auth/o2/token

# --- ヤフオク! 監視 ---
# scraping のポライトネス設定
YAHOO_BASE_URL=https://page.auctions.yahoo.co.jp/jp/auction/
YAHOO_REQUEST_INTERVAL_MS=3000
YAHOO_USER_AGENT="ResaleAutoSyncBot/0.1 (contact: you@example.com)"
# 監視バックエンド: cheerio | puppeteer
YAHOO_FETCH_MODE=cheerio

# --- Cron ---
# 既定 20 分おき。crontab 記法。
MONITOR_CRON="*/20 * * * *"
# 1 回のジョブで同時に監視する最大件数（レート制御）
MONITOR_CONCURRENCY=3

# --- 安全弁 ---
# true の間は Amazon への書き込み（PUT/PATCH）を実行せずログのみ（ドライラン）
DRY_RUN=true
