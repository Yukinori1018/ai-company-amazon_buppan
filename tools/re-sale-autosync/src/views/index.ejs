<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Re-Sale AutoSync — 監視ダッシュボード</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 24px; color: #222; }
    h1 { font-size: 20px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 16px; }
    label { display: block; font-size: 12px; color: #555; margin-top: 8px; }
    input, select { width: 100%; padding: 6px; box-sizing: border-box; }
    button { margin-top: 12px; padding: 8px 14px; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 13px; }
    th, td { border-bottom: 1px solid #eee; padding: 6px 8px; text-align: left; }
    .badge { padding: 2px 8px; border-radius: 999px; font-size: 12px; }
    .ACTIVE { background: #e6f4ea; color: #137333; }
    .INACTIVE, .ENDED, .CANCELLED, .NOT_FOUND { background: #fce8e6; color: #c5221f; }
    .PENDING, .UNKNOWN { background: #fef7e0; color: #b06000; }
    .out { background: #f5f5f5; padding: 8px; font-family: monospace; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Re-Sale AutoSync — 監視ダッシュボード</h1>

  <div class="grid">
    <!-- リサーチ＆出品 -->
    <div class="card">
      <h2 style="font-size:16px;">リサーチ＆出品</h2>
      <label>ASIN</label>
      <input id="asin" placeholder="B0XXXXXXXX" />
      <label>ヤフオク! オークションID</label>
      <input id="yahooId" placeholder="x1234567890" />
      <label>productType（SP-API）</label>
      <input id="productType" placeholder="例: PET_SUPPLIES" />
      <label>SKU（自社管理コード）</label>
      <input id="sku" placeholder="YAHOO-x1234567890" />
      <label>想定落札価格（円）</label>
      <input id="bid" type="number" value="3000" />
      <label>仕入れ送料（円）</label>
      <input id="ship" type="number" value="800" />
      <label>目標利益率</label>
      <input id="margin" type="number" step="0.01" value="0.20" />
      <button onclick="preview()">価格プレビュー</button>
      <button onclick="submitList()">出品する</button>
      <div id="out" class="out"></div>
    </div>

    <!-- 監視中一覧 -->
    <div class="card">
      <h2 style="font-size:16px;">監視中（<%= products.length %>件）</h2>
      <table>
        <thead>
          <tr><th>SKU</th><th>ASIN</th><th>ヤフオクID</th><th>状態</th><th>在庫</th><th>価格</th></tr>
        </thead>
        <tbody>
          <% products.forEach(function (p) { %>
            <tr>
              <td><%= p.sku %></td>
              <td><%= p.asin %></td>
              <td><%= p.auction ? p.auction.yahooAuctionId : '-' %></td>
              <td><span class="badge <%= p.auction ? p.auction.status : 'UNKNOWN' %>"><%= p.auction ? p.auction.status : '-' %></span></td>
              <td><span class="badge <%= p.listingState %>"><%= p.quantity %></span></td>
              <td>¥<%= p.sellPrice.toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <button onclick="runMonitor()">今すぐ監視を1周実行</button>
    </div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const show = (o) => ($('out').textContent = JSON.stringify(o, null, 2));

    async function preview() {
      const r = await fetch('/api/price/preview', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          assumedWinningBid: +$('bid').value, procurementShipping: +$('ship').value,
          targetMargin: +$('margin').value,
        }),
      });
      show(await r.json());
    }

    async function submitList() {
      const r = await fetch('/api/list', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          asin: $('asin').value, sku: $('sku').value, productType: $('productType').value,
          yahooAuctionId: $('yahooId').value, assumedWinningBid: +$('bid').value,
          procurementShipping: +$('ship').value, targetMargin: +$('margin').value,
        }),
      });
      show(await r.json());
      if (r.ok) setTimeout(() => location.reload(), 1200);
    }

    async function runMonitor() {
      await fetch('/api/monitor/run', { method: 'POST' });
      location.reload();
    }
  </script>
</body>
</html>
