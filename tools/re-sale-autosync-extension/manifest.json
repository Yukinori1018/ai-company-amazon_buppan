{
  "manifest_version": 3,
  "name": "Re-Sale AutoSync（無在庫 ヤフオク⇄Amazon 同期）",
  "version": "0.4.0",
  "description": "無在庫物販の『Amazonで売れたのに仕入れられない』を防ぐ。ヤフオクが先に売れたらAmazon在庫0、Amazon注文が入ったらヤフオク購入を1クリック確認で確定。",
  "permissions": ["storage", "alarms", "notifications", "tabs", "scripting"],
  "host_permissions": [
    "*://*.auctions.yahoo.co.jp/*",
    "*://paypayfleamarket.yahoo.co.jp/*",
    "*://*.yahoo.co.jp/*",
    "*://sellercentral.amazon.co.jp/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Re-Sale AutoSync",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.auctions.yahoo.co.jp/*", "*://paypayfleamarket.yahoo.co.jp/*"],
      "js": ["src/lib/pricing.js", "src/content/yahoo.js"]
    },
    {
      "matches": ["*://sellercentral.amazon.co.jp/*"],
      "js": ["src/content/amazon_seller.js"]
    }
  ]
}
