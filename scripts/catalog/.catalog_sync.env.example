# 成果物カタログ同期の設定見本
# このファイルを同じディレクトリに .catalog_sync.env としてコピーし、値を埋めてください。
# .catalog_sync.env は .gitignore 対象（Git にコミットされません）。

# Apps Script ウェブアプリのデプロイ URL（末尾が /exec のもの）
WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# 共有シークレット。Apps Script の Script Property "SHARED_TOKEN" と同じ値にする。
# 任意の長いランダム文字列（例: openssl rand -hex 24 で生成）
SHARED_TOKEN=replace-with-a-long-random-string

# 書き込み先シート名（任意）。空のままなら先頭シートに書き込みます。
SHEET_NAME=
