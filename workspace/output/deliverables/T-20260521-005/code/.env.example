# Sato-Scope 環境変数（コピーして .env として配置）

# Keepa API（Power-User Plan €49/月）。未設定なら自動的にモックモード
KEEPA_API_KEY=

# 楽天市場 商品検索 API ApplicationID（無料）。https://webservice.rakuten.co.jp/ で発行
RAKUTEN_APP_ID=

# Yahoo!ショッピング Web API Client ID（無料）。https://e.developer.yahoo.co.jp/dashboard/ で発行
YAHOO_APP_ID=

# デバッグモード
DEBUG=false
