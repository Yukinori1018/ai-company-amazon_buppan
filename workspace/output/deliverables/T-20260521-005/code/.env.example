# Sato-Scope Discovery — 環境変数サンプル
# このファイルを .env にコピーするか、シェルで export してください。
# ★ シークレットは絶対に Git にコミットしないこと（.env は .gitignore 済み想定）。

# Yahoo!ショッピング Web API のアプリケーションID（Client ID）
# 取得: https://e.developer.yahoo.co.jp/dashboard/  → 無料・即時発行
# 未設定なら自動でサンプルデータにフォールバックします。
YAHOO_APP_ID=

# Keepa API キー（Amazon側データ用・有料 €49/月 ＝ 社長承認 §4.1 必須）
# 取得: https://keepa.com/#!api
# 未設定なら Amazon側はサンプルデータにフォールバックします。
KEEPA_API_KEY=

# ─ 仕入れ先②：楽天市場 商品検索 API（新 Rakuten Developers ポータル・無料）─
# 取得: https://developers.rakuten.com/  → アプリ登録で app_id(UUID) と accessKey(pk_...) を発行
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# アフィリエイトID（任意。商品検索だけなら不要なので未設定でOK）
RAKUTEN_AFFILIATE_ID=
# ★重要★ 新APIは Referer/Origin が必須で、その値が楽天管理画面の「許可するWebサイト」
# 登録ドメインと一致しないと 403(HTTP_REFERRER_NOT_ALLOWED) で弾かれます。
# 楽天管理画面で公開ドメインを1つ登録し、同じ値をここに入れてください（例: https://your-domain.example/）。
# 未設定だと楽天はサンプルにフォールバックします（Yahoo単独で動作）。
RAKUTEN_REFERER=

# ─ 仕入れ先③：NETSEA（卸）Buyer API（無料・トークン認証）─
# 取得: NETSEAマイページ https://www.netsea.jp/account/ のAPI設定画面でアクセストークンを発行
#       （有効期限180日。漏洩注意。不要になったら必ず削除）
# 認証は HTTP ヘッダ Authorization: Bearer <token> で送ります（コード側で自動付与）。
# 卸価格で同JAN最安を狙える第3の網。未設定ならサンプルにフォールバックします。
NETSEA_API_TOKEN=
