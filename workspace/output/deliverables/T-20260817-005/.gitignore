# Keepa の生レスポンス。--from-raw の再集計用にローカルには残すが、
# サイズが大きくリポを汚すため Git 追跡はしない（成果物は CSV / summary.json）。
raw/

# offers 付きレスポンス（実セラー数の確定用）。同じ理由で追跡しない。
raw_offers/

# 作業中バックアップ（例: scan_v13.py.bak）。ローカルには残すが Git 追跡はしない。
# ※ ファイルは削除しない。追跡対象から外すだけ（CLAUDE.md §4.1 不可逆な削除の回避）。
*.bak

# --- scan_v14（継続スキャン）-------------------------------------------------
# Keepa の生レスポンス。--from-raw の再集計に使うのでローカルには残すが、
# サイズが大きいので Git には入れない（過去に23MBを履歴に混入させた前科あり）。
v14/raw/
v14/raw_offers/
# 取得済み ASIN の台帳（--resume 用）。数万行のテキストになるので追跡しない。
v14/seen_asins.txt
# 実行ログ（追記され続ける）。要点は progress.json と CSV に出る。
v14/scan_v14.log
v14/*.log
# 走行時の一時状態（成果物ではない）。CSV / progress.json / HTML だけを追跡する。
v14/*.pid
v14/STOP
v14/FINISHED
v14/shard_cursors.json
v14/*.csv.tmp

# --- T-20260831-002（常時稼働）で追加 ---------------------------------------
# 常時稼働にすると、これらは追記で無限に育ちます。実測 1,104 B/行なので、
# 母集団48,760件を掘り切った時点で 01 は約54MB、HTML は約36MB。
# 30分ごとの github-sync がこれを毎回コミットすると PUBLIC リポが数GBになり、
# 1ファイル100MB を超えた瞬間に **会社全体の自動同期が恒久的に止まります**。
#
# だから Git に載せるのは
#   ・03_メーカー名寄せ.csv（社長が実際に連絡に使う。メーカー単位なので小さい）
#   ・00_サマリ.md / progress.json（数十行）
# だけにします。下の3つはローカルには残り、社長の Finder からも見えます
# （`~/Documents/AI Company Outputs/Amazon物販事業` は deliverables への
#   シンボリックリンクなので、**Git 追跡と可視性は無関係**です）。
v14/01_候補プール_全件.csv
v14/02_候補リスト_社長用.csv
v14/00_候補リスト.html
v14/ALERT.md
v14/heartbeat.json
